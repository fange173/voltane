# 本地运行时可复制为 .env；NAS 部署请直接改 docker-compose.yml
SECRET_KEY=voltane-dev-secret-change-me
DATABASE_URL=sqlite:////app/data/voltane.db
TZ=Asia/Shanghai
LOGIN_MAX_FAILURES=8
LOGIN_LOCK_SECONDS=300
TRUST_PROXY_HEADERS=false
COOKIE_SECURE=false
ENABLE_DOCS=false
RESET_ADMIN_PASSWORD=false
BACKUP_KEEP=14
TRASH_RETENTION_DAYS=30
ACTIVITY_RETENTION_DAYS=180
